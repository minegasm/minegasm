# Local install targets for `./gradlew installJars` in the Classic build.
#
# Copy this file to `mods-install.env` (gitignored) and set each line to the
# `mods` folder of the matching Minecraft instance. `installJars` builds every
# Classic version and copies its reobfuscated jar into the folder set here.
#
# - Key = Minecraft version (`1.7.10`, `1.8.9`, `1.12.2`), exactly as below.
# - Value = absolute path to that instance's `mods` folder (raw, unescaped —
#   Windows backslashes are fine; surrounding quotes are optional).
# - Leave a line blank / commented to skip that version.
# - Before copying, any existing `minegasm-classic-*.jar` in the target folder
#   is removed first, so a version bump never leaves two Minegasm jars behind.

1.7.10=
1.8.9=
1.12.2=

# Example (delete the leading '# ' and adjust):
# 1.12.2=C:\Users\me\curseforge\minecraft\Instances\Forge 1.12.2\mods
# 1.7.10=C:\Users\me\AppData\Roaming\.minecraft-1.7.10\mods
