# Local install targets for `./gradlew installJars` in the Classic build.
#
# Copy this file to `mods-install.env` (gitignored) and set each line to the
# `mods` folder of the matching Minecraft instance. `installJars` builds every
# Classic subproject and copies its reobfuscated jar into the folder set here.
#
# - Key = subproject name (`<mcversion>-<loader>`), exactly as below.
# - Value = absolute path to that instance's `mods` folder (raw, unescaped —
#   Windows backslashes are fine; surrounding quotes are optional).
# - Leave a line blank / commented to skip that subproject.
# - Before copying, any existing jar for the same version+loader
#   (`minegasm-...+mc<ver>-<loader>.jar`) in the target folder is removed first,
#   so a mod-version bump never leaves two Minegasm jars behind.

1.7.10-forge=
1.8.9-forge=
1.12.2-forge=
1.16.5-forge=
1.16.5-fabric=

# Example (delete the leading '# ' and adjust):
# 1.12.2-forge=C:\Users\me\curseforge\minecraft\Instances\Forge 1.12.2\mods
# 1.16.5-fabric=C:\Users\me\AppData\Roaming\.minecraft-fabric-1.16.5\mods
