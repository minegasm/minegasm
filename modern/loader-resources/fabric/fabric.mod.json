{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description_long}",
  "authors": [
    "Minegasm contributors"
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "https://issues.minegasm.net"
  },
  "license": "AGPL-3.0-only",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.minegasm.fabric.MinegasmMod"
    ],
    "modmenu": [
      "net.minegasm.fabric.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": "${minecraftVersion}"
  }
}
